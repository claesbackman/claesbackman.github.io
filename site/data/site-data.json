  "pipeline": [
    {
      "file": "10_build_housing_return_by_decile.do",
      "purpose": "Creates the housing return gradient by income decile using the paper's baseline housing-gains estimate.",
      "outputs": [
        "housing_return_by_decile.dta"
      ]
    },
    {
      "file": "11_build_shares_by_decile.do",
      "purpose": "Builds Danish gross-asset shares and risky-financial shares by income decile.",
      "outputs": [
        "shares_by_decile.dta",
        "dk_risky_share_by_decile.dta"
      ]
    },
    {
      "file": "12_build_scf_shares_returns.do",
      "purpose": "Builds the SCF comparison portfolio shares and risky-financial shares for US households.",
      "outputs": [
        "scf_shares_by_decile.dta",
        "scf_risky_share_by_decile.dta"
      ]
    },
    {
      "file": "13_inputs_DK.do",
      "purpose": "Builds Danish risk-free, OMXC20, and pension return inputs for the passive calibration.",
      "outputs": [
        "risk_free.dta",
        "OMXC20_annual.dta",
        "pension_returns.dta"
      ]
    },
    {
      "file": "13c_inputs_US.do",
      "purpose": "Builds US real stock and safe returns for the SCF passive calibration.",
      "outputs": [
        "sp500_annual.dta"
      ]
    },
    {
      "file": "15_PortfolioDecomposition.do",
      "purpose": "Combines portfolio shares and return gradients into asset contributions and the three-way decomposition.",
      "outputs": [
        "portfolio_decomposition.dta",
        "Table_PortfolioDecomposition.tex"
      ]
    }
  ]
